# ---- API ----
DATABASE_URL=postgresql://dantes@localhost:5434/dantes
DATABASE_URL_TEST=postgresql://dantes@localhost:5434/dantes_test
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
JWT_SECRET=change-me-long-random
SEED_OWNER_EMAIL=owner@dantespizza.co.ke
SEED_OWNER_PASSWORD=change-me-now
# Rate limits per IP per minute
LOGIN_RATE_LIMIT=10
CHECKOUT_RATE_LIMIT=10
LOOKUP_RATE_LIMIT=30

# Payments: "mock" simulates providers locally; "live" uses the credentials below
PAYMENTS_MODE=mock
# Production refuses to boot with mock payments unless this is true (staging only)
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=change-me-random-path-token
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Notifications: providers fall back to logging when credentials are blank
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_URL=
EMAIL_FROM="Dante's Pizza <orders@dantespizza.co.ke>"

# --- Vercel + Neon (production) -------------------------------------------
# DATABASE_URL          Neon *pooled* connection string (host contains "-pooler"), e.g.
#                       postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dantes?sslmode=require&pgbouncer=true&connection_limit=5
# DATABASE_URL_UNPOOLED Neon direct connection string; used only for `prisma migrate deploy` on production builds.
#                       (The Neon integration on Vercel sets both automatically.)
# STOREFRONT_URL / ADMIN_URL / PUBLIC_API_URL may be left unset on Vercel: they default to
#                       https://<production domain>, https://<production domain>/admin and https://<production domain>.
# BLOB_READ_WRITE_TOKEN Vercel Blob store token; when set, admin image uploads go to Blob instead of local disk.
BLOB_READ_WRITE_TOKEN=
