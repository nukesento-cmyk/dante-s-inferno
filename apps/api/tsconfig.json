{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "ES2022",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": ".",
    "isolatedModules": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noEmit": false,
    "incremental": false,
    "types": ["node", "multer"]
  },
  "include": ["src", "test", "prisma", "vitest.config.ts"]
}
