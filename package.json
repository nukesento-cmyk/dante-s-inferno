{
  "name": "dantes-pizza",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "pnpm --filter @dantes/e2e test",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
